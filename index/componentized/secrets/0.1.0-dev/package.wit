package componentized:secrets@0.1.0-dev;

@since(version = 0.1.0-dev)
interface store {
  variant error-code {
    not-found,
    other(option<string>),
  }

  variant secret {
    %string(string),
    bytes(list<u8>),
  }

  get: async func(key: string) -> result<secret, error-code>;
}

world provider {
  export store;
}
world imports {
  import store;
}
