  /// Determines whether a field exists in a hash.
  ///
  /// HEXISTS key field
  /// https://valkey.io/commands/hexists/
  @since(version = 0.3.0-dev)
  hexists: async func(connection: borrow<connection>, key: string, field: string) -> result<bool, error-code>;

  /// Sets the expiration time of one or more hash fields in seconds.
