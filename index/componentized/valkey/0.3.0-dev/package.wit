  @since(version = 0.3.0-dev)
  hgetdel: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<list<option<string-or-bytes>>, error-code>;

  /// Gets the value of one or more fields of a given hash key, and optionally sets their expiration time or time-to-live (TTL).
  ///
