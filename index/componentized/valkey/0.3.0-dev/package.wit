  @since(version = 0.3.0-dev)
  module-list: async func(connection: borrow<connection>) -> result<list<module-list-entry>, error-code>;

  /// Loads a module.
  ///
  /// MODULE LOAD path [ arg [ arg ... ] ]
  /// https://valkey.io/commands/module-load/
  @since(version = 0.3.0-dev)
  module-load: async func(connection: borrow<connection>, path: string, args: option<list<string>>) -> result<_, error-code>;

  /// Loads a module using extended parameters.
