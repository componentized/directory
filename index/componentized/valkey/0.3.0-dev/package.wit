  /// HEXPIREAT key unix-time-seconds [ NX | XX | GT | LT ] FIELDS numfields field [ field ... ]
  /// https://valkey.io/commands/hexpireat/
  @since(version = 0.3.0-dev)
  hexpireat: async func(connection: borrow<connection>, key: string, seconds: unix-time-seconds, mode: option<ttl-mode>, fields: list<string>) -> result<list<hexpireat-result>, error-code>;

  /// Returns Unix timestamps in seconds since the epoch at which the given key's field(s) will expire.
  ///
  /// HEXPIRETIME key FIELDS numfields field [ field ... ]
  /// https://valkey.io/commands/hexpiretime/
  @since(version = 0.3.0-dev)
  hexpiretime: async func(connection: borrow<connection>, key: string, fields: list<string>) -> result<list<hexpiretime-reply>, error-code>;

  /// Returns the value of a field in a hash.
  ///
