  /// MODULE LOADEX path [ CONFIG name value [ CONFIG name value ... ] ] [ ARGS args [ args ... ] ]
  /// https://valkey.io/commands/module-loadex/
  @since(version = 0.3.0-dev)
  module-loadex: async func(connection: borrow<connection>, path: string, configs: option<list<tuple<string, string>>>, args: option<list<string>>) -> result<_, error-code>;

  /// Unloads a module.
  ///
  /// MODULE UNLOAD name
  /// https://valkey.io/commands/module-unload/
  @since(version = 0.3.0-dev)
  module-unload: async func(connection: borrow<connection>, name: string) -> result<_, error-code>;

  /// Configures a server as replica of another, or promotes it to a primary.
  ///
  /// None makes the server a primary, `NO ONE`.
  ///
  /// REPLICAOF 〈 host port | NO ONE 〉
  /// https://valkey.io/commands/replicaof/
  @since(version = 0.3.0-dev)
  replicaof: async func(connection: borrow<connection>, primary: option<tuple<string, u16>>) -> result<string, error-code>;

  /// Returns the replication role.
  ///
  /// ROLE
  /// https://valkey.io/commands/role/
  @since(version = 0.3.0-dev)
  role: async func(connection: borrow<connection>) -> result<role-reply, error-code>;

  /// Synchronously saves the database(s) to disk.
  ///
  /// SAVE
  /// https://valkey.io/commands/save/
  @since(version = 0.3.0-dev)
  save: async func(connection: borrow<connection>) -> result<_, error-code>;

  /// Synchronously saves the database(s) to disk and shuts down the server.
  ///
  /// The server closes the connection once it stops, so a shutdown that succeeds fails the call
  /// with a closed error.
  ///
  /// See also `shutdown-abort`.
  ///
  /// SHUTDOWN [ NOSAVE | SAVE ] [ NOW ] [ FORCE ] [ SAFE ] [ FAILOVER ]
  /// https://valkey.io/commands/shutdown/
  @since(version = 0.3.0-dev)
  shutdown: async func(connection: borrow<connection>, save: option<shutdown-save>, modifiers: shutdown-flags) -> result<_, error-code>;

  /// Synchronously saves the database(s) to disk and shuts down the server.
  ///
  /// The `ABORT` form, aborting a shutdown in progress.
  ///
  /// See also `shutdown`.
  ///
  /// SHUTDOWN ABORT
  /// https://valkey.io/commands/shutdown/
  @since(version = 0.3.0-dev)
  shutdown-abort: async func(connection: borrow<connection>) -> result<_, error-code>;

  /// Returns the slow log's entries.
  ///
  /// SLOWLOG GET [ count ]
  /// https://valkey.io/commands/slowlog-get/
  @since(version = 0.3.0-dev)
  slowlog-get: async func(connection: borrow<connection>, count: option<integer>) -> result<list<slowlog-entry>, error-code>;

  /// Returns the number of entries in the slow log.
  ///
  /// SLOWLOG LEN
  /// https://valkey.io/commands/slowlog-len/
  @since(version = 0.3.0-dev)
  slowlog-len: async func(connection: borrow<connection>) -> result<integer, error-code>;

  /// Clears all entries from the slow log.
  ///
  /// SLOWLOG RESET
  /// https://valkey.io/commands/slowlog-reset/
  @since(version = 0.3.0-dev)
  slowlog-reset: async func(connection: borrow<connection>) -> result<_, error-code>;

  /// Counts the number of set bits (population counting) in a string.
  ///
  /// BITCOUNT key [ start [ end [ BYTE | BIT ] ] ]
  /// https://valkey.io/commands/bitcount/
  @since(version = 0.3.0-dev)
  bitcount: async func(connection: borrow<connection>, key: string, range: option<bit-range>) -> result<integer, error-code>;

  /// Performs arbitrary bitfield integer operations on strings.
  ///
  /// None for a write that failed with `OVERFLOW FAIL`.
  ///
  /// BITFIELD key [ GET encoding offset | [ OVERFLOW WRAP | SAT | FAIL ] 〈 SET encoding offset value | INCRBY encoding offset increment 〉 [ GET encoding offset | [ OVERFLOW WRAP | SAT | FAIL ] 〈 SET encoding offset value | INCRBY encoding offset increment 〉 ... ] ]
  /// https://valkey.io/commands/bitfield/
  @since(version = 0.3.0-dev)
  bitfield: async func(connection: borrow<connection>, key: string, operations: option<list<bitfield-operation>>) -> result<list<option<integer>>, error-code>;

  /// Performs arbitrary read-only bitfield integer operations on strings.
  ///
  /// BITFIELD_RO key [ GET encoding offset [ GET encoding offset ... ] ]
  /// https://valkey.io/commands/bitfield_ro/
  @since(version = 0.3.0-dev)
  bitfield-ro: async func(connection: borrow<connection>, key: string, gets: option<list<bitfield-ro-get>>) -> result<list<integer>, error-code>;

  /// Performs bitwise operations on multiple strings, and stores the result.
  ///
  /// BITOP 〈 AND | OR | XOR | NOT 〉 destkey key [ key ... ]
  /// https://valkey.io/commands/bitop/
  @since(version = 0.3.0-dev)
  bitop: async func(connection: borrow<connection>, destination: string, operation: bitop-operation) -> result<integer, error-code>;

  /// Finds the first set (1) or clear (0) bit in a string.
  ///
  /// None when no bit matches, the server's `-1`.
  ///
  /// BITPOS key bit [ start [ end [ BYTE | BIT ] ] ]
  /// https://valkey.io/commands/bitpos/
  @since(version = 0.3.0-dev)
  bitpos: async func(connection: borrow<connection>, key: string, bit: bool, range: option<bit-range>) -> result<option<integer>, error-code>;

  /// Returns a bit value by offset.
  ///
  /// GETBIT key offset
  /// https://valkey.io/commands/getbit/
  @since(version = 0.3.0-dev)
  getbit: async func(connection: borrow<connection>, key: string, offset: u64) -> result<bool, error-code>;

  /// Sets or clears the bit at offset of the string value.
  ///
  /// SETBIT key offset value
  /// https://valkey.io/commands/setbit/
  @since(version = 0.3.0-dev)
  setbit: async func(connection: borrow<connection>, key: string, offset: u64, value: bool) -> result<bool, error-code>;

  /// Signals that a cluster client is following an -ASK redirect.
  ///
  /// It applies to the next command on the connection, which may be another caller's when the
  /// connection is shared. Use a connection of your own.
  ///
  /// ASKING
  /// https://valkey.io/commands/asking/
  @since(version = 0.3.0-dev)
  asking: async func(connection: borrow<connection>) -> result<_, error-code>;

  /// Authenticates the connection.
  ///
  /// AUTH [ username ] password
  /// https://valkey.io/commands/auth/
  @since(version = 0.3.0-dev)
  auth: async func(connection: borrow<connection>, username: option<string>, password: string) -> result<_, error-code>;

  /// Instructs the server whether to track the keys in the next request.
  ///
  /// It applies to the next command on the connection, which may be another caller's when the
  /// connection is shared. Use a connection of your own.
  ///
  /// CLIENT CACHING 〈 YES | NO 〉
  /// https://valkey.io/commands/client-caching/
  @since(version = 0.3.0-dev)
  client-caching: async func(connection: borrow<connection>, enabled: bool) -> result<_, error-code>;

  /// A client claims its capability.
  ///
  /// CLIENT CAPA capability [ capability ... ]
  /// https://valkey.io/commands/client-capa/
  @since(version = 0.3.0-dev)
  client-capa: async func(connection: borrow<connection>, capabilities: list<string>) -> result<_, error-code>;

  /// Returns the name of the connection.
  ///
  /// CLIENT GETNAME
  /// https://valkey.io/commands/client-getname/
  @since(version = 0.3.0-dev)
  client-getname: async func(connection: borrow<connection>) -> result<option<string>, error-code>;

  /// Returns the unique client ID of the connection.
  ///
  /// CLIENT ID
  /// https://valkey.io/commands/client-id/
  @since(version = 0.3.0-dev)
  client-id: async func(connection: borrow<connection>) -> result<integer, error-code>;

  /// Marks this client as an import source when the server is in import mode.
  ///
  /// CLIENT IMPORT-SOURCE 〈 ON | OFF 〉
  /// https://valkey.io/commands/client-import-source/
  @since(version = 0.3.0-dev)
  client-import-source: async func(connection: borrow<connection>, enabled: bool) -> result<_, error-code>;

  /// Returns information about the connection.
  ///
  /// A map of the fields, parsed from the server's text, e.g. `id`, `addr` and `name`.
  ///
  /// CLIENT INFO
  /// https://valkey.io/commands/client-info/
  @since(version = 0.3.0-dev)
  client-info: async func(connection: borrow<connection>) -> result<map<string, string>, error-code>;

  /// Controls whether commands sent by the client affect the LRU/LFU of accessed keys.
  ///
  /// It applies to the connection, so to every caller sharing it.
  ///
  /// CLIENT NO-TOUCH 〈 ON | OFF 〉
  /// https://valkey.io/commands/client-no-touch/
  @since(version = 0.3.0-dev)
  client-no-touch: async func(connection: borrow<connection>, enabled: bool) -> result<_, error-code>;

  /// Sets information specific to the client or connection.
  ///
  /// CLIENT SETINFO 〈 LIB-NAME libname | LIB-VER libver 〉
  /// https://valkey.io/commands/client-setinfo/
  @since(version = 0.3.0-dev)
  client-setinfo: async func(connection: borrow<connection>, attr: client-setinfo-attr) -> result<_, error-code>;

  /// Sets the connection name.
  ///
  /// CLIENT SETNAME connection-name
  /// https://valkey.io/commands/client-setname/
  @since(version = 0.3.0-dev)
  client-setname: async func(connection: borrow<connection>, connection-name: string) -> result<_, error-code>;

  /// Controls server-assisted client-side caching for the connection.
  ///
  /// Invalidations arrive as push messages, see `connection.dead-letters`. It applies to the
  /// connection, so to every caller sharing it.
  ///
  /// CLIENT TRACKING 〈 ON | OFF 〉 [ PREFIX prefix [ PREFIX prefix ... ] ] [ BCAST ] [ OPTIN ] [ OPTOUT ] [ NOLOOP ]
  /// https://valkey.io/commands/client-tracking/
  @since(version = 0.3.0-dev)
  client-tracking: async func(connection: borrow<connection>, options: option<client-tracking-options>) -> result<_, error-code>;

  /// Returns information about server-assisted client-side caching for the connection.
  ///
  /// CLIENT TRACKINGINFO
  /// https://valkey.io/commands/client-trackinginfo/
  @since(version = 0.3.0-dev)
  client-trackinginfo: async func(connection: borrow<connection>) -> result<client-trackinginfo-reply, error-code>;

  /// Returns detailed information about all commands.
  ///
  /// COMMAND
  /// https://valkey.io/commands/command/
  @since(version = 0.3.0-dev)
  command: async func(connection: borrow<connection>) -> result<list<command-reply>, error-code>;

  /// Returns a count of commands.
  ///
  /// COMMAND COUNT
  /// https://valkey.io/commands/command-count/
  @since(version = 0.3.0-dev)
  command-count: async func(connection: borrow<connection>) -> result<integer, error-code>;

  /// Returns documentary information about one, multiple or all commands.
  ///
  /// A container is followed by its subcommands. Commands that do not exist are left out.
  ///
  /// COMMAND DOCS [ command-name [ command-name ... ] ]
  /// https://valkey.io/commands/command-docs/
  @since(version = 0.3.0-dev)
  command-docs: async func(connection: borrow<connection>, command-names: option<list<string>>) -> result<list<command-docs-reply>, error-code>;

  /// Extracts the key names from an arbitrary command.
  ///
  /// COMMAND GETKEYS command [ arg [ arg ... ] ]
  /// https://valkey.io/commands/command-getkeys/
  @since(version = 0.3.0-dev)
  command-getkeys: async func(connection: borrow<connection>, command: list<string>) -> result<list<string>, error-code>;

  /// Extracts the key names and access flags for an arbitrary command.
