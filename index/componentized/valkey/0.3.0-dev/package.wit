  /// ZINTERSTORE destination numkeys key [ key ... ] [ WEIGHTS weight [ weight ... ] ] [ AGGREGATE SUM | MIN | MAX ]
  /// https://valkey.io/commands/zinterstore/
  @since(version = 0.3.0-dev)
  zinterstore: async func(connection: borrow<connection>, destination: string, keys: list<string>, weights: option<list<double>>, aggregate: option<zset-aggregate>) -> result<integer, error-code>;

  /// Returns the number of members in a sorted set within a lexicographical range.
  ///
  /// ZLEXCOUNT key min max
  /// https://valkey.io/commands/zlexcount/
  @since(version = 0.3.0-dev)
  zlexcount: async func(connection: borrow<connection>, key: string, min: lex-bound, max: lex-bound) -> result<integer, error-code>;

  /// Returns the highest- or lowest-scoring members from one or more sorted sets after removing them.
  ///
  /// ZMPOP numkeys key [ key ... ] 〈 MIN | MAX 〉 [ COUNT count ]
  /// https://valkey.io/commands/zmpop/
  @since(version = 0.3.0-dev)
  zmpop: async func(connection: borrow<connection>, keys: list<string>, end: zmpop-end, count: option<integer>) -> result<option<tuple<string, list<tuple<string-or-bytes, double>>>>, error-code>;

  /// Returns the score of one or more members in a sorted set.
  ///
  /// ZMSCORE key member [ member ... ]
  /// https://valkey.io/commands/zmscore/
  @since(version = 0.3.0-dev)
  zmscore: async func(connection: borrow<connection>, key: string, members: list<string-or-bytes>) -> result<list<option<double>>, error-code>;

  /// Returns the highest-scoring members from a sorted set after removing them.
  ///
  /// Without a count, at most one member.
  ///
  /// ZPOPMAX key [ count ]
  /// https://valkey.io/commands/zpopmax/
  @since(version = 0.3.0-dev)
  zpopmax: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<tuple<string-or-bytes, double>>, error-code>;

  /// Returns the lowest-scoring members from a sorted set after removing them.
  ///
  /// Without a count, at most one member.
  ///
  /// ZPOPMIN key [ count ]
  /// https://valkey.io/commands/zpopmin/
  @since(version = 0.3.0-dev)
  zpopmin: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<tuple<string-or-bytes, double>>, error-code>;

  /// Returns one or more random members from a sorted set.
  ///
  /// Without a count, at most one member.
  ///
  /// See also `zrandmember-withscores`.
  ///
  /// ZRANDMEMBER key [ count ]
  /// https://valkey.io/commands/zrandmember/
  @since(version = 0.3.0-dev)
  zrandmember: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<list<string-or-bytes>, error-code>;

  /// Returns one or more random members from a sorted set.
  ///
  /// The `WITHSCORES` form, the members and their scores.
  ///
  /// See also `zrandmember`.
  ///
  /// ZRANDMEMBER key count WITHSCORES
  /// https://valkey.io/commands/zrandmember/
  @since(version = 0.3.0-dev)
  zrandmember-withscores: async func(connection: borrow<connection>, key: string, count: integer) -> result<list<tuple<string-or-bytes, double>>, error-code>;

  /// Returns members in a sorted set within a range of indexes.
  ///
  /// Also covers ZRANGEBYLEX, ZRANGEBYSCORE, ZREVRANGE, ZREVRANGEBYLEX and ZREVRANGEBYSCORE. A
  /// limit fails the command unless the range is by score or by lex. With `xx`, returns none when
  /// the key does not exist.
  ///
  /// See also `zrange-withscores`.
  ///
  /// ZRANGE key start stop [ BYSCORE | BYLEX ] [ REV ] [ LIMIT offset count ] [ XX ]
  /// https://valkey.io/commands/zrange/
  @since(version = 0.3.0-dev)
  zrange: async func(connection: borrow<connection>, key: string, range: zrange-by, rev: bool, limit: option<limit>, xx: bool) -> result<option<list<string-or-bytes>>, error-code>;

  /// Returns members in a sorted set within a range of indexes.
  ///
  /// The `WITHSCORES` form, the members and their scores. A limit fails the command unless the
  /// range is by score. With `xx`, returns none when the key does not exist.
  ///
  /// See also `zrange`.
  ///
  /// ZRANGE key start stop [ BYSCORE ] [ REV ] [ LIMIT offset count ] WITHSCORES [ XX ]
  /// https://valkey.io/commands/zrange/
  @since(version = 0.3.0-dev)
  zrange-withscores: async func(connection: borrow<connection>, key: string, range: zrange-withscores-by, rev: bool, limit: option<limit>, xx: bool) -> result<option<list<tuple<string-or-bytes, double>>>, error-code>;

  /// Stores a range of members from sorted set in a key.
  ///
  /// A limit fails the command unless the range is by score or by lex.
  ///
  /// ZRANGESTORE dst src min max [ BYSCORE | BYLEX ] [ REV ] [ LIMIT offset count ]
  /// https://valkey.io/commands/zrangestore/
  @since(version = 0.3.0-dev)
  zrangestore: async func(connection: borrow<connection>, destination: string, source: string, range: zrangestore-by, rev: bool, limit: option<limit>) -> result<integer, error-code>;

  /// Returns the index of a member in a sorted set ordered by ascending scores.
  ///
  /// See also `zrank-withscore`.
  ///
  /// ZRANK key member
  /// https://valkey.io/commands/zrank/
  @since(version = 0.3.0-dev)
  zrank: async func(connection: borrow<connection>, key: string, member: string-or-bytes) -> result<option<integer>, error-code>;

  /// Returns the index of a member in a sorted set ordered by ascending scores.
  ///
  /// The `WITHSCORE` form, the position and the score.
  ///
  /// See also `zrank`.
  ///
  /// ZRANK key member WITHSCORE
  /// https://valkey.io/commands/zrank/
  @since(version = 0.3.0-dev)
  zrank-withscore: async func(connection: borrow<connection>, key: string, member: string-or-bytes) -> result<option<tuple<integer, double>>, error-code>;

  /// Removes one or more members from a sorted set.
  ///
  /// ZREM key member [ member ... ]
  /// https://valkey.io/commands/zrem/
  @since(version = 0.3.0-dev)
  zrem: async func(connection: borrow<connection>, key: string, members: list<string-or-bytes>) -> result<integer, error-code>;

  /// Removes members in a sorted set within a lexicographical range.
  ///
  /// ZREMRANGEBYLEX key min max
  /// https://valkey.io/commands/zremrangebylex/
  @since(version = 0.3.0-dev)
  zremrangebylex: async func(connection: borrow<connection>, key: string, min: lex-bound, max: lex-bound) -> result<integer, error-code>;

  /// Removes members in a sorted set within a range of indexes.
  ///
  /// ZREMRANGEBYRANK key start stop
  /// https://valkey.io/commands/zremrangebyrank/
  @since(version = 0.3.0-dev)
  zremrangebyrank: async func(connection: borrow<connection>, key: string, start: integer, stop: integer) -> result<integer, error-code>;

  /// Removes members in a sorted set within a range of scores.
  ///
  /// ZREMRANGEBYSCORE key min max
  /// https://valkey.io/commands/zremrangebyscore/
  @since(version = 0.3.0-dev)
  zremrangebyscore: async func(connection: borrow<connection>, key: string, min: score-bound, max: score-bound) -> result<integer, error-code>;

  /// Returns the index of a member in a sorted set ordered by descending scores.
  ///
  /// See also `zrevrank-withscore`.
  ///
  /// ZREVRANK key member
  /// https://valkey.io/commands/zrevrank/
  @since(version = 0.3.0-dev)
  zrevrank: async func(connection: borrow<connection>, key: string, member: string-or-bytes) -> result<option<integer>, error-code>;

  /// Returns the index of a member in a sorted set ordered by descending scores.
  ///
  /// The `WITHSCORE` form, the position and the score.
  ///
  /// See also `zrevrank`.
  ///
  /// ZREVRANK key member WITHSCORE
  /// https://valkey.io/commands/zrevrank/
  @since(version = 0.3.0-dev)
  zrevrank-withscore: async func(connection: borrow<connection>, key: string, member: string-or-bytes) -> result<option<tuple<integer, double>>, error-code>;

  /// Iterates over members and scores of a sorted set.
  ///
  /// See also `zscan-noscores`.
  ///
  /// ZSCAN key cursor [ MATCH pattern ] [ COUNT count ]
  /// https://valkey.io/commands/zscan/
  @since(version = 0.3.0-dev)
  zscan: async func(connection: borrow<connection>, key: string, cursor: cursor, match: option<string>, count: option<integer>) -> result<tuple<option<cursor>, list<tuple<string-or-bytes, double>>>, error-code>;

  /// Iterates over members and scores of a sorted set.
  ///
  /// The `NOSCORES` form, the members only.
  ///
  /// See also `zscan`.
  ///
  /// ZSCAN key cursor [ MATCH pattern ] [ COUNT count ] NOSCORES
  /// https://valkey.io/commands/zscan/
  @since(version = 0.3.0-dev)
  zscan-noscores: async func(connection: borrow<connection>, key: string, cursor: cursor, match: option<string>, count: option<integer>) -> result<tuple<option<cursor>, list<string-or-bytes>>, error-code>;

  /// Returns the score of a member in a sorted set.
  ///
  /// ZSCORE key member
  /// https://valkey.io/commands/zscore/
  @since(version = 0.3.0-dev)
  zscore: async func(connection: borrow<connection>, key: string, member: string-or-bytes) -> result<option<double>, error-code>;

  /// Returns the union of multiple sorted sets.
  ///
  /// See also `zunion-withscores`.
  ///
  /// ZUNION numkeys key [ key ... ] [ WEIGHTS weight [ weight ... ] ] [ AGGREGATE SUM | MIN | MAX ]
  /// https://valkey.io/commands/zunion/
  @since(version = 0.3.0-dev)
  zunion: async func(connection: borrow<connection>, keys: list<string>, weights: option<list<double>>, aggregate: option<zset-aggregate>) -> result<list<string-or-bytes>, error-code>;

  /// Returns the union of multiple sorted sets.
  ///
  /// The `WITHSCORES` form, the members and their combined scores.
  ///
  /// See also `zunion`.
  ///
  /// ZUNION numkeys key [ key ... ] [ WEIGHTS weight [ weight ... ] ] [ AGGREGATE SUM | MIN | MAX ] WITHSCORES
  /// https://valkey.io/commands/zunion/
  @since(version = 0.3.0-dev)
  zunion-withscores: async func(connection: borrow<connection>, keys: list<string>, weights: option<list<double>>, aggregate: option<zset-aggregate>) -> result<list<tuple<string-or-bytes, double>>, error-code>;

  /// Stores the union of multiple sorted sets in a key.
  ///
  /// ZUNIONSTORE destination numkeys key [ key ... ] [ WEIGHTS weight [ weight ... ] ] [ AGGREGATE SUM | MIN | MAX ]
  /// https://valkey.io/commands/zunionstore/
  @since(version = 0.3.0-dev)
  zunionstore: async func(connection: borrow<connection>, destination: string, keys: list<string>, weights: option<list<double>>, aggregate: option<zset-aggregate>) -> result<integer, error-code>;

  /// Returns the number of messages that were successfully acknowledged by the consumer group member of a stream.
  ///
  /// XACK key group ID [ ID ... ]
  /// https://valkey.io/commands/xack/
  @since(version = 0.3.0-dev)
  xack: async func(connection: borrow<connection>, key: string, group: string, ids: list<stream-id>) -> result<integer, error-code>;

  /// Appends a new message to a stream.
  ///
  /// XADD key [ NOMKSTREAM ] [ 〈 MAXLEN | MINID 〉 [ = | ~ ] threshold [ LIMIT count ] ] 〈 * | id 〉 field value [ field value ... ]
  /// https://valkey.io/commands/xadd/
  @since(version = 0.3.0-dev)
  xadd: async func(connection: borrow<connection>, key: string, nomkstream: bool, trim: option<stream-trim>, id: stream-id, field-and-values: list<tuple<string, string-or-bytes>>) -> result<option<stream-id>, error-code>;

  /// Changes, or acquires, ownership of messages in a consumer group, as if the messages were delivered to a consumer group member.
  ///
  /// A start of none scans from the beginning, `0-0`. The next start is returned, none once the
  /// scan is complete.
  ///
  /// See also `xautoclaim-justid`.
  ///
  /// XAUTOCLAIM key group consumer min-idle-time start [ COUNT count ]
  /// https://valkey.io/commands/xautoclaim/
  @since(version = 0.3.0-dev)
  xautoclaim: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration-milliseconds, start: option<stream-id>, count: option<integer>) -> result<tuple<option<stream-id>, list<tuple<stream-id, map<string, string-or-bytes>>>, list<stream-id>>, error-code>;

  /// Changes, or acquires, ownership of messages in a consumer group, as if the messages were delivered to a consumer group member.
  ///
  /// The `JUSTID` form, the IDs only. A start of none scans from the beginning, `0-0`. The next
  /// start is returned, none once the scan is complete.
  ///
  /// See also `xautoclaim`.
  ///
  /// XAUTOCLAIM key group consumer min-idle-time start [ COUNT count ] JUSTID
  /// https://valkey.io/commands/xautoclaim/
  @since(version = 0.3.0-dev)
  xautoclaim-justid: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration-milliseconds, start: option<stream-id>, count: option<integer>) -> result<tuple<option<stream-id>, list<stream-id>, list<stream-id>>, error-code>;

  /// Changes, or acquires, ownership of a message in a consumer group, as if the message was delivered to a consumer group member.
  ///
  /// See also `xclaim-justid`.
  ///
  /// XCLAIM key group consumer min-idle-time ID [ ID ... ] [ IDLE ms ] [ TIME unix-time-milliseconds ] [ RETRYCOUNT count ] [ FORCE ] [ LASTID lastid ]
  /// https://valkey.io/commands/xclaim/
  @since(version = 0.3.0-dev)
  xclaim: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration-milliseconds, ids: list<stream-id>, opts: option<xclaim-opts>) -> result<list<tuple<stream-id, map<string, string-or-bytes>>>, error-code>;

  /// Changes, or acquires, ownership of a message in a consumer group, as if the message was delivered to a consumer group member.
  ///
  /// The `JUSTID` form, the IDs only.
  ///
  /// See also `xclaim`.
  ///
  /// XCLAIM key group consumer min-idle-time ID [ ID ... ] [ IDLE ms ] [ TIME unix-time-milliseconds ] [ RETRYCOUNT count ] [ FORCE ] JUSTID [ LASTID lastid ]
  /// https://valkey.io/commands/xclaim/
  @since(version = 0.3.0-dev)
  xclaim-justid: async func(connection: borrow<connection>, key: string, group: string, consumer: string, min-idle-time: duration-milliseconds, ids: list<stream-id>, opts: option<xclaim-opts>) -> result<list<stream-id>, error-code>;

  /// Returns the number of messages after removing them from a stream.
  ///
  /// XDEL key ID [ ID ... ]
  /// https://valkey.io/commands/xdel/
  @since(version = 0.3.0-dev)
  xdel: async func(connection: borrow<connection>, key: string, ids: list<stream-id>) -> result<integer, error-code>;

  /// Creates a consumer group.
  ///
  /// XGROUP CREATE key group 〈 id | $ 〉 [ MKSTREAM ] [ ENTRIESREAD entriesread ]
  /// https://valkey.io/commands/xgroup-create/
  @since(version = 0.3.0-dev)
  xgroup-create: async func(connection: borrow<connection>, key: string, group: string, id: stream-id, mkstream: bool, entriesread: option<integer>) -> result<_, error-code>;

  /// Creates a consumer in a consumer group.
  ///
  /// XGROUP CREATECONSUMER key group consumer
  /// https://valkey.io/commands/xgroup-createconsumer/
  @since(version = 0.3.0-dev)
  xgroup-createconsumer: async func(connection: borrow<connection>, key: string, group: string, consumer: string) -> result<bool, error-code>;

  /// Deletes a consumer from a consumer group.
  ///
  /// XGROUP DELCONSUMER key group consumer
  /// https://valkey.io/commands/xgroup-delconsumer/
  @since(version = 0.3.0-dev)
  xgroup-delconsumer: async func(connection: borrow<connection>, key: string, group: string, consumer: string) -> result<integer, error-code>;

  /// Destroys a consumer group.
  ///
  /// XGROUP DESTROY key group
  /// https://valkey.io/commands/xgroup-destroy/
  @since(version = 0.3.0-dev)
  xgroup-destroy: async func(connection: borrow<connection>, key: string, group: string) -> result<bool, error-code>;

  /// Sets the last-delivered ID of a consumer group.
  ///
  /// XGROUP SETID key group 〈 id | $ 〉 [ ENTRIESREAD entriesread ]
  /// https://valkey.io/commands/xgroup-setid/
  @since(version = 0.3.0-dev)
  xgroup-setid: async func(connection: borrow<connection>, key: string, group: string, id: stream-id, entriesread: option<integer>) -> result<_, error-code>;

  /// Returns a list of the consumers in a consumer group.
  ///
  /// XINFO CONSUMERS key group
  /// https://valkey.io/commands/xinfo-consumers/
  @since(version = 0.3.0-dev)
  xinfo-consumers: async func(connection: borrow<connection>, key: string, group: string) -> result<list<xinfo-consumers-entry>, error-code>;

  /// Returns a list of the consumer groups of a stream.
  ///
  /// XINFO GROUPS key
  /// https://valkey.io/commands/xinfo-groups/
  @since(version = 0.3.0-dev)
  xinfo-groups: async func(connection: borrow<connection>, key: string) -> result<list<xinfo-groups-entry>, error-code>;

  /// Returns information about a stream.
  ///
  /// See also `xinfo-stream-full`.
  ///
  /// XINFO STREAM key
  /// https://valkey.io/commands/xinfo-stream/
  @since(version = 0.3.0-dev)
  xinfo-stream: async func(connection: borrow<connection>, key: string) -> result<xinfo-stream-reply, error-code>;

  /// Returns information about a stream.
  ///
  /// The `FULL` form, with the entries, groups and consumers.
  ///
  /// See also `xinfo-stream`.
  ///
  /// XINFO STREAM key FULL [ COUNT count ]
  /// https://valkey.io/commands/xinfo-stream/
  @since(version = 0.3.0-dev)
  xinfo-stream-full: async func(connection: borrow<connection>, key: string, count: option<integer>) -> result<xinfo-stream-reply-full, error-code>;

  /// Returns the number of messages in a stream.
  ///
  /// XLEN key
  /// https://valkey.io/commands/xlen/
  @since(version = 0.3.0-dev)
  xlen: async func(connection: borrow<connection>, key: string) -> result<integer, error-code>;

  /// Returns the information and entries from a stream consumer group's pending entries list.
  ///
  /// The summary form.
  ///
  /// See also `xpending-extended`.
  ///
  /// XPENDING key group
  /// https://valkey.io/commands/xpending/
  @since(version = 0.3.0-dev)
  xpending: async func(connection: borrow<connection>, key: string, group: string) -> result<xpending-summary, error-code>;

  /// Returns the information and entries from a stream consumer group's pending entries list.
  ///
  /// The extended form, the pending entries in the range.
  ///
  /// See also `xpending`.
  ///
  /// XPENDING key group [ IDLE min-idle-time ] start end count [ consumer ]
  /// https://valkey.io/commands/xpending/
  @since(version = 0.3.0-dev)
  xpending-extended: async func(connection: borrow<connection>, key: string, group: string, min-idle-time: option<duration-milliseconds>, start: stream-id, end: stream-id, count: integer, consumer: option<string>) -> result<list<xpending-extended-entry>, error-code>;

  /// Returns the messages from a stream within a range of IDs.
  ///
  /// XRANGE key start end [ COUNT count ]
  /// https://valkey.io/commands/xrange/
  @since(version = 0.3.0-dev)
  xrange: async func(connection: borrow<connection>, key: string, start: stream-id, end: stream-id, count: option<integer>) -> result<list<tuple<stream-id, map<string, string-or-bytes>>>, error-code>;

  /// Returns messages from multiple streams with IDs greater than the ones requested.
  ///
  /// With `block`, returns none when the timeout passed. The connection waits too, replies to
  /// commands sent after it on the connection wait behind it. Use a connection of your own.
  ///
  /// XREAD [ COUNT count ] [ BLOCK milliseconds ] STREAMS key [ key ... ] ID [ ID ... ]
  /// https://valkey.io/commands/xread/
  @since(version = 0.3.0-dev)
  xread: async func(connection: borrow<connection>, count: option<integer>, block: option<duration-milliseconds>, keys: list<string>, ids: list<stream-id>) -> result<option<map<string, list<tuple<stream-id, map<string, string-or-bytes>>>>>, error-code>;

  /// Returns new or historical messages from a stream for a consumer in a group.
  ///
  /// The fields of an entry are none when it was deleted after it was delivered, e.g. when
  /// reading the pending entries with the ID `0`.
  ///
  /// With `block`, returns none when the timeout passed. The connection waits too, replies to
  /// commands sent after it on the connection wait behind it. Use a connection of your own.
  ///
  /// XREADGROUP GROUP group consumer [ COUNT count ] [ BLOCK milliseconds ] [ NOACK ] STREAMS key [ key ... ] ID [ ID ... ]
  /// https://valkey.io/commands/xreadgroup/
  @since(version = 0.3.0-dev)
  xreadgroup: async func(connection: borrow<connection>, group: string, consumer: string, count: option<integer>, block: option<duration-milliseconds>, noack: bool, keys: list<string>, ids: list<stream-id>) -> result<option<map<string, list<tuple<stream-id, option<map<string, string-or-bytes>>>>>>, error-code>;

  /// Returns the messages from a stream within a range of IDs in reverse order.
  ///
  /// XREVRANGE key end start [ COUNT count ]
  /// https://valkey.io/commands/xrevrange/
  @since(version = 0.3.0-dev)
  xrevrange: async func(connection: borrow<connection>, key: string, end: stream-id, start: stream-id, count: option<integer>) -> result<list<tuple<stream-id, map<string, string-or-bytes>>>, error-code>;

  /// An internal command for replicating stream values.
  ///
  /// XSETID key last-id [ ENTRIESADDED entries-added ] [ MAXDELETEDID max-deleted-id ]
  /// https://valkey.io/commands/xsetid/
  @since(version = 0.3.0-dev)
  xsetid: async func(connection: borrow<connection>, key: string, last-id: stream-id, entries-added: option<integer>, max-deleted-id: option<stream-id>) -> result<_, error-code>;

  /// Deletes messages from the beginning of a stream.
  ///
  /// XTRIM key 〈 MAXLEN | MINID 〉 [ = | ~ ] threshold [ LIMIT count ]
  /// https://valkey.io/commands/xtrim/
  @since(version = 0.3.0-dev)
  xtrim: async func(connection: borrow<connection>, key: string, trim: stream-trim) -> result<integer, error-code>;

  /// Appends a string to the value of a key.
  ///
  /// APPEND key value
  /// https://valkey.io/commands/append/
  @since(version = 0.3.0-dev)
  append: async func(connection: borrow<connection>, key: string, value: string-or-bytes) -> result<integer, error-code>;

  /// Decrements the integer value of a key by one.
  ///
  /// DECR key
  /// https://valkey.io/commands/decr/
  @since(version = 0.3.0-dev)
  decr: async func(connection: borrow<connection>, key: string) -> result<integer, error-code>;

  /// Decrements the integer value of a key by a number.
  ///
  /// DECRBY key decrement
  /// https://valkey.io/commands/decrby/
  @since(version = 0.3.0-dev)
  decrby: async func(connection: borrow<connection>, key: string, decrement: integer) -> result<integer, error-code>;

  /// Delete key if value matches string.
  ///
  /// DELIFEQ key value
  /// https://valkey.io/commands/delifeq/
  @since(version = 0.3.0-dev)
  delifeq: async func(connection: borrow<connection>, key: string, value: string-or-bytes) -> result<bool, error-code>;

  /// Returns the string value of a key.
  ///
  /// GET key
  /// https://valkey.io/commands/get/
  @since(version = 0.3.0-dev)
  get: async func(connection: borrow<connection>, key: string) -> result<option<string-or-bytes>, error-code>;

  /// Returns the string value of a key after deleting the key.
  ///
  /// GETDEL key
  /// https://valkey.io/commands/getdel/
  @since(version = 0.3.0-dev)
  getdel: async func(connection: borrow<connection>, key: string) -> result<option<string-or-bytes>, error-code>;

  /// Returns the string value of a key after setting its expiration time.
  ///
  /// GETEX key [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | PERSIST ]
  /// https://valkey.io/commands/getex/
  @since(version = 0.3.0-dev)
  getex: async func(connection: borrow<connection>, key: string, ttl: option<getex-ttl>) -> result<option<string-or-bytes>, error-code>;

  /// Returns a substring of the string stored at a key.
  ///
  /// GETRANGE key start end
  /// https://valkey.io/commands/getrange/
  @since(version = 0.3.0-dev)
  getrange: async func(connection: borrow<connection>, key: string, start: integer, end: integer) -> result<string-or-bytes, error-code>;

  /// Returns the previous string value of a key after setting it to a new value.
  ///
  /// GETSET key value
  /// https://valkey.io/commands/getset/
  @since(version = 0.3.0-dev)
  getset: async func(connection: borrow<connection>, key: string, value: string-or-bytes) -> result<option<string-or-bytes>, error-code>;

  /// Increments the integer value of a key by one.
  ///
  /// INCR key
  /// https://valkey.io/commands/incr/
  @since(version = 0.3.0-dev)
  incr: async func(connection: borrow<connection>, key: string) -> result<integer, error-code>;

  /// Increments the integer value of a key by a number.
  ///
  /// INCRBY key increment
  /// https://valkey.io/commands/incrby/
  @since(version = 0.3.0-dev)
  incrby: async func(connection: borrow<connection>, key: string, increment: integer) -> result<integer, error-code>;

  /// Increments the floating point value of a key by a number.
  ///
  /// INCRBYFLOAT key increment
  /// https://valkey.io/commands/incrbyfloat/
  @since(version = 0.3.0-dev)
  incrbyfloat: async func(connection: borrow<connection>, key: string, increment: double) -> result<double, error-code>;

  /// Finds the longest common substring.
  ///
  /// See also `lcs-len` and `lcs-idx`.
  ///
  /// LCS key1 key2
  /// https://valkey.io/commands/lcs/
  @since(version = 0.3.0-dev)
  lcs: async func(connection: borrow<connection>, key1: string, key2: string) -> result<string-or-bytes, error-code>;

  /// Finds the longest common substring.
  ///
  /// The `LEN` form, the length only.
  ///
  /// See also `lcs` and `lcs-idx`.
  ///
  /// LCS key1 key2 LEN
  /// https://valkey.io/commands/lcs/
  @since(version = 0.3.0-dev)
  lcs-len: async func(connection: borrow<connection>, key1: string, key2: string) -> result<integer, error-code>;

  /// Finds the longest common substring.
  ///
  /// The `IDX` form, the ranges of the matches.
  ///
  /// See also `lcs` and `lcs-len`.
  ///
  /// LCS key1 key2 IDX [ MINMATCHLEN min-match-len ] [ WITHMATCHLEN ]
  /// https://valkey.io/commands/lcs/
  @since(version = 0.3.0-dev)
  lcs-idx: async func(connection: borrow<connection>, key1: string, key2: string, min-match-len: option<integer>, with-match-len: bool) -> result<lcs-idx-reply, error-code>;

  /// Atomically returns the string values of one or more keys.
  ///
  /// MGET key [ key ... ]
  /// https://valkey.io/commands/mget/
  @since(version = 0.3.0-dev)
  mget: async func(connection: borrow<connection>, keys: list<string>) -> result<list<option<string-or-bytes>>, error-code>;

  /// Atomically creates or modifies the string values of one or more keys.
  ///
  /// MSET key value [ key value ... ]
  /// https://valkey.io/commands/mset/
  @since(version = 0.3.0-dev)
  mset: async func(connection: borrow<connection>, keys-and-values: list<tuple<string, string-or-bytes>>) -> result<_, error-code>;

  /// Atomically creates or modifies the string values of one or more keys, and optionally set their expiration.
  ///
  /// MSETEX numkeys key value [ key value ... ] [ NX | XX ] [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | KEEPTTL ]
  /// https://valkey.io/commands/msetex/
  @since(version = 0.3.0-dev)
  msetex: async func(connection: borrow<connection>, keys-and-values: list<tuple<string, string-or-bytes>>, precondition: option<msetex-precondition>, ttl: option<msetex-ttl>) -> result<bool, error-code>;

  /// Atomically modifies the string values of one or more keys only when all keys don't exist.
  ///
  /// MSETNX key value [ key value ... ]
  /// https://valkey.io/commands/msetnx/
  @since(version = 0.3.0-dev)
  msetnx: async func(connection: borrow<connection>, keys-and-values: list<tuple<string, string-or-bytes>>) -> result<bool, error-code>;

  /// Sets both string value and expiration time in milliseconds of a key.
  ///
  /// PSETEX key milliseconds value
  /// https://valkey.io/commands/psetex/
  @since(version = 0.3.0-dev)
  psetex: async func(connection: borrow<connection>, key: string, milliseconds: duration-milliseconds, value: string-or-bytes) -> result<_, error-code>;

  /// Sets the string value of a key, ignoring its type.
  ///
  /// Returns false when the precondition is not met, the key is unchanged.
  ///
  /// See also `set-get`.
  ///
  /// SET key value [ NX | XX | IFEQ comparison-value | IFNE comparison-not-equal ] [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | KEEPTTL ]
  /// https://valkey.io/commands/set/
  @since(version = 0.3.0-dev)
  set: async func(connection: borrow<connection>, key: string, value: string-or-bytes, precondition: option<set-precondition>, ttl: option<set-ttl>) -> result<bool, error-code>;

  /// Sets the string value of a key, ignoring its type.
  ///
  /// The `GET` form, returning the previous value, none when the key did not exist.
  ///
  /// See also `set`.
  ///
  /// SET key value [ NX | XX | IFEQ comparison-value | IFNE comparison-not-equal ] GET [ EX seconds | PX milliseconds | EXAT unix-time-seconds | PXAT unix-time-milliseconds | KEEPTTL ]
  /// https://valkey.io/commands/set/
  @since(version = 0.3.0-dev)
  set-get: async func(connection: borrow<connection>, key: string, value: string-or-bytes, precondition: option<set-precondition>, ttl: option<set-ttl>) -> result<option<string-or-bytes>, error-code>;

  /// Sets the string value and expiration time of a key.
  ///
  /// SETEX key seconds value
  /// https://valkey.io/commands/setex/
  @since(version = 0.3.0-dev)
  setex: async func(connection: borrow<connection>, key: string, seconds: duration-seconds, value: string-or-bytes) -> result<_, error-code>;

  /// Sets the string value of a key only when the key doesn't exist.
  ///
  /// SETNX key value
  /// https://valkey.io/commands/setnx/
  @since(version = 0.3.0-dev)
  setnx: async func(connection: borrow<connection>, key: string, value: string-or-bytes) -> result<bool, error-code>;

  /// Overwrites a part of a string value with another by an offset.
  ///
  /// SETRANGE key offset value
  /// https://valkey.io/commands/setrange/
  @since(version = 0.3.0-dev)
  setrange: async func(connection: borrow<connection>, key: string, offset: u32, value: string-or-bytes) -> result<integer, error-code>;

  /// Returns the length of a string value.
  ///
  /// STRLEN key
  /// https://valkey.io/commands/strlen/
  @since(version = 0.3.0-dev)
  strlen: async func(connection: borrow<connection>, key: string) -> result<integer, error-code>;

  /// Returns a substring from a string value.
  ///
  /// SUBSTR key start end
  /// https://valkey.io/commands/substr/
  @since(version = 0.3.0-dev)
  substr: async func(connection: borrow<connection>, key: string, start: integer, end: integer) -> result<string-or-bytes, error-code>;
}

/// Establishes connections, with a transport and settings chosen by whoever provides it, e.g. from
/// configuration.
///
/// A component that needs a connection, but not a say in how it is made, imports a connector, the
/// composition decides which one, e.g. `tcp-connector`.
@since(version = 0.3.0-dev)
interface connector {
  @since(version = 0.3.0-dev)
  use types.{error-code};
  @since(version = 0.3.0-dev)
  use connection.{connection};

  /// Establishes a new connection.
  @since(version = 0.3.0-dev)
  connect: async func() -> result<connection, error-code>;
}

/// A transport for connections over wasi:sockets TCP.
interface tcp {
  @since(version = 0.3.0-dev)
  use types.{connect-opts, error-code, resp-value};
  @since(version = 0.3.0-dev)
  use connection.{connection};

  /// A TCP connection to a Valkey server, framing the bytes it carries into RESP values in each
  /// direction.
  @since(version = 0.3.0-dev)
  resource transport {
    /// Opens a transport to `host`, a hostname or an IP address. Each address the host resolves
    /// to is tried in turn.
    @since(version = 0.3.0-dev)
    open: static async func(host: string, port: u16) -> result<transport, error-code>;
    /// Writes each value from `requests` to the server, in order.
    ///
    /// May be called at most once, like `tcp-socket.send`. Closing `requests` half-closes the
    /// socket. The future resolves once every value is written, or with the error that stopped
    /// writing.
    @since(version = 0.3.0-dev)
    send: func(requests: stream<resp-value>) -> future<result<_, error-code>>;
    /// The values the server sends, in order.
    ///
    /// May be called at most once, like `tcp-socket.receive`. The stream closes when the server
    /// closes the socket, the future resolves to `ok` for a graceful close or to the error
    /// otherwise.
    @since(version = 0.3.0-dev)
    receive: func() -> tuple<stream<resp-value>, future<result<_, error-code>>>;
  }

  /// Opens a transport and establishes a connection over it with `opts`, see `connection.new`.
  ///
  /// The connection keeps the transport alive.
  @since(version = 0.3.0-dev)
  connect: async func(host: string, port: u16, opts: option<connect-opts>) -> result<connection, error-code>;
}

world imports {
  import types;
  import connection;
  import commands;
  import connector;
  import tcp;
  import tcp-connector-constants;
}
