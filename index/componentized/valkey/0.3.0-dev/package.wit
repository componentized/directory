  ///
  /// COMMAND INFO [ command-name [ command-name ... ] ]
  /// https://valkey.io/commands/command-info/
  @since(version = 0.3.0-dev)
  command-info: async func(connection: borrow<connection>, command-names: option<list<string>>) -> result<list<command-info-reply>, error-code>;

  /// Returns a list of command names.
  ///
  /// COMMAND LIST [ FILTERBY 〈 MODULE module-name | ACLCAT category | PATTERN pattern 〉 ]
  /// https://valkey.io/commands/command-list/
  @since(version = 0.3.0-dev)
  command-list: async func(connection: borrow<connection>, filter: option<command-list-filter>) -> result<list<string>, error-code>;

  /// Returns the given string.
  ///
  /// ECHO message
  /// https://valkey.io/commands/echo/
  @since(version = 0.3.0-dev)
  echo: async func(connection: borrow<connection>, message: string-or-bytes) -> result<string-or-bytes, error-code>;

  /// Returns the server's liveliness response.
  ///
  /// PING [ message ]
  /// https://valkey.io/commands/ping/
  @since(version = 0.3.0-dev)
  ping: async func(connection: borrow<connection>, message: option<string-or-bytes>) -> result<_, error-code>;

  /// Enables read-only queries for a connection to a Valkey replica node.
  ///
  /// It applies to the connection, so to every caller sharing it.
  ///
  /// READONLY
  /// https://valkey.io/commands/readonly/
  @since(version = 0.3.0-dev)
  readonly: async func(connection: borrow<connection>) -> result<_, error-code>;

  /// Enables read-write queries for a connection to a Valkey replica node.
  ///
  /// It applies to the connection, so to every caller sharing it.
  ///
  /// READWRITE
  /// https://valkey.io/commands/readwrite/
  @since(version = 0.3.0-dev)
  readwrite: async func(connection: borrow<connection>) -> result<_, error-code>;

  /// Changes the selected database.
  ///
  /// It applies to the connection, so to every caller sharing it.
  ///
  /// SELECT index
  /// https://valkey.io/commands/select/
  @since(version = 0.3.0-dev)
  select: async func(connection: borrow<connection>, index: integer) -> result<_, error-code>;

  /// Blocks until the asynchronous replication of all preceding write commands sent by the connection is completed.
  ///
  /// The connection waits too, replies to commands sent after it on the connection wait behind
  /// it. Use a connection of your own.
  ///
  /// WAIT numreplicas timeout
  /// https://valkey.io/commands/wait/
  @since(version = 0.3.0-dev)
  wait: async func(connection: borrow<connection>, numreplicas: integer, timeout: duration-milliseconds) -> result<integer, error-code>;

  /// Blocks until all of the preceding write commands sent by the connection are written to the append-only file of the primary and/or replicas.
  ///
  /// The connection waits too, replies to commands sent after it on the connection wait behind
  /// it. Use a connection of your own.
  ///
  /// WAITAOF numlocal numreplicas timeout
  /// https://valkey.io/commands/waitaof/
  @since(version = 0.3.0-dev)
  waitaof: async func(connection: borrow<connection>, numlocal: integer, numreplicas: integer, timeout: duration-milliseconds) -> result<tuple<integer, integer>, error-code>;

  /// Adds one or more members to a geospatial index.
