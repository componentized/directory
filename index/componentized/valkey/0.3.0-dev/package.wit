  /// https://valkey.io/commands/hget/
  @since(version = 0.3.0-dev)
  hget: async func(connection: borrow<connection>, key: string, field: string) -> result<option<string-or-bytes>, error-code>;

  /// Returns all fields and values in a hash.
  ///
  /// HGETALL key
  /// https://valkey.io/commands/hgetall/
  @since(version = 0.3.0-dev)
  hgetall: async func(connection: borrow<connection>, key: string) -> result<map<string, string-or-bytes>, error-code>;

