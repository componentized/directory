  /// GEOADD key [ NX | XX ] [ CH ] longitude latitude member [ longitude latitude member ... ]
  /// https://valkey.io/commands/geoadd/
  @since(version = 0.3.0-dev)
  geoadd: async func(connection: borrow<connection>, key: string, condition: option<geoadd-condition>, changed: bool, coordinates-and-members: list<tuple<geo-coordinates, string-or-bytes>>) -> result<integer, error-code>;

  /// Returns the distance between two members of a geospatial index.
  ///
  /// GEODIST key member1 member2 [ m | km | ft | mi ]
  /// https://valkey.io/commands/geodist/
  @since(version = 0.3.0-dev)
  geodist: async func(connection: borrow<connection>, key: string, member1: string-or-bytes, member2: string-or-bytes, unit: option<geo-unit>) -> result<option<double>, error-code>;

  /// Returns members from a geospatial index as geohash strings.
  ///
  /// GEOHASH key [ member [ member ... ] ]
  /// https://valkey.io/commands/geohash/
  @since(version = 0.3.0-dev)
  geohash: async func(connection: borrow<connection>, key: string, members: option<list<string-or-bytes>>) -> result<list<option<string>>, error-code>;

  /// Returns the longitude and latitude of members from a geospatial index.
  ///
  /// GEOPOS key [ member [ member ... ] ]
  /// https://valkey.io/commands/geopos/
  @since(version = 0.3.0-dev)
  geopos: async func(connection: borrow<connection>, key: string, members: option<list<string-or-bytes>>) -> result<list<option<geo-coordinates>>, error-code>;

  /// Queries a geospatial index for members inside an area of a box, circle, or a polygon.
  ///
  /// See also `geosearch-with`.
  ///
  /// GEOSEARCH key [ FROMMEMBER member | FROMLONLAT longitude latitude ] 〈 BYRADIUS radius 〈 m | km | ft | mi 〉 | BYBOX width height 〈 m | km | ft | mi 〉 | BYPOLYGON num-vertices longitude latitude [ longitude latitude ... ] 〉 [ ASC | DESC ] [ COUNT count [ ANY ] ]
  /// https://valkey.io/commands/geosearch/
  @since(version = 0.3.0-dev)
  geosearch: async func(connection: borrow<connection>, key: string, shape: geosearch-shape, order: option<sort-order>, count: option<geosearch-count>) -> result<list<string-or-bytes>, error-code>;

  /// Queries a geospatial index for members inside an area of a box, circle, or a polygon.
  ///
  /// Returns each member with the details asked for, `WITHCOORD`, `WITHDIST` and `WITHHASH`.
  ///
  /// See also `geosearch`.
  ///
  /// GEOSEARCH key [ FROMMEMBER member | FROMLONLAT longitude latitude ] 〈 BYRADIUS radius 〈 m | km | ft | mi 〉 | BYBOX width height 〈 m | km | ft | mi 〉 | BYPOLYGON num-vertices longitude latitude [ longitude latitude ... ] 〉 [ ASC | DESC ] [ COUNT count [ ANY ] ] [ WITHCOORD ] [ WITHDIST ] [ WITHHASH ]
  /// https://valkey.io/commands/geosearch/
  @since(version = 0.3.0-dev)
  geosearch-with: async func(connection: borrow<connection>, key: string, shape: geosearch-shape, order: option<sort-order>, count: option<geosearch-count>, details: geosearch-with-flags) -> result<list<geosearch-with-result>, error-code>;

  /// Queries a geospatial index for members inside an area of a box, a circle, or a polygon, optionally stores the result.
  ///
  /// GEOSEARCHSTORE destination source [ FROMMEMBER member | FROMLONLAT longitude latitude ] 〈 BYRADIUS radius 〈 m | km | ft | mi 〉 | BYBOX width height 〈 m | km | ft | mi 〉 | BYPOLYGON num-vertices longitude latitude [ longitude latitude ... ] 〉 [ ASC | DESC ] [ COUNT count [ ANY ] ] [ STOREDIST ]
  /// https://valkey.io/commands/geosearchstore/
  @since(version = 0.3.0-dev)
  geosearchstore: async func(connection: borrow<connection>, destination: string, source: string, shape: geosearchstore-shape, order: option<sort-order>, count: option<geosearchstore-count>, storedist: bool) -> result<integer, error-code>;

  /// Deletes one or more fields and their values from a hash.
  ///
  /// HDEL key field [ field ... ]
  /// https://valkey.io/commands/hdel/
  @since(version = 0.3.0-dev)
