  @since(version = 0.3.0-dev)
  hlen: async func(connection: borrow<connection>, key: string) -> result<integer, error-code>;

  /// Returns the values of all fields in a hash.
  ///
  /// HMGET key field [ field ... ]
  /// https://valkey.io/commands/hmget/
  @since(version = 0.3.0-dev)
