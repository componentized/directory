/// A counter released over three major versions, to show how the directory lists and
/// compares a package's versions.
///
/// A synthetic package: it isn't published to any registry.
package kitchen-sink:releases@0.2.1;

/// A counter, counting up from zero, one at a time.
interface counter {
  /// The current count.
  get: func() -> u32;

  /// Adds one to the count.
  increment: func();
}
